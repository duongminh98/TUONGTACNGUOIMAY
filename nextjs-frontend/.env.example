# Node/Express (auth, dashboard, translator words, …) — default :8000, see nodejs-backend/.env PORT
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI (action-detection: sign-to-text, text-to-sign) — default :8001, same as `npm run dev` / uvicorn
NEXT_PUBLIC_ML_API_BASE_URL=http://localhost:8001

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json
