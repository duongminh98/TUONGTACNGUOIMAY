# Node/Express API (auth, dashboard, translator words, …) — see nodejs-backend/.env PORT
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI: /v1/action-detection/sign-to-text, /text-to-sign (default uvicorn :8000)
NEXT_PUBLIC_ML_API_BASE_URL=http://localhost:8000

# If Express already listens on :8000, run FastAPI on another port and point ML there, e.g.:
# NEXT_PUBLIC_ML_API_BASE_URL=http://localhost:8001

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json
