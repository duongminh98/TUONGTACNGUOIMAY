# Node/Express API (auth, dashboard, translator words, …)
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI only: sign-to-text / text-to-sign. Defaults to http://localhost:8000 if unset.
# Set this when the Node API and FastAPI run on different ports, e.g. Node :5000 + FastAPI :8000.
# NEXT_PUBLIC_ML_API_BASE_URL=http://localhost:8000

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json
